<Window
    x:Class="SimpleScraper.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="WindowRoot" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleRegion" Padding="16,0,140,0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/SimpleScraper.png" Width="24" Height="24" Stretch="Uniform" />
                <TextBlock Text="简单刮削器" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="SimpleScraper" FontSize="12" Opacity="0.65" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
        <ContentControl x:Name="Workspace" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Grid>
</Window>
