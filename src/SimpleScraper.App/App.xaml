<Application
    x:Class="SimpleScraper.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:SimpleScraper.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Styles/FluentStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="DenseRowTemplate">
                <views:DenseRowPresenter Row="{Binding}" />
            </DataTemplate>
            <ItemsPanelTemplate x:Key="DenseRowsPanel">
                <ItemsStackPanel Orientation="Vertical" CacheLength="2" />
            </ItemsPanelTemplate>
            <DataTemplate x:Key="LibraryRootTemplate">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding KindLabel}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding Path}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="ColumnPreferenceTemplate">
                <views:ColumnPreferencePresenter Preference="{Binding}" />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
